generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
}

enum SourceStatus {
  PENDING
  DISCOVERING
  DONE
  ERROR
}

enum VideoStatus {
  DISCOVERED
  SELECTED
  DOWNLOADING
  DOWNLOADED
  TRANSCRIBING
  TRANSCRIBED
  EXTRACTING
  EXTRACTED
  FAILED
  SKIPPED
}

enum BatchStatus {
  DRAFT
  ESTIMATED
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum BatchItemStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum CostEventKind {
  ACTUAL
  ESTIMATE
}

model Source {
  id                  String       @id @default(cuid())
  url                 String       @unique
  platform            Platform
  name                String
  requestedVideoCount Int
  status              SourceStatus @default(PENDING)
  errorMessage        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  videos              Video[]
}

model Video {
  id           String                       @id @default(cuid())
  sourceId     String
  source       Source                       @relation(fields: [sourceId], references: [id])
  externalId   String
  url          String
  title        String
  description  String?
  thumbnail    String?
  publishedAt  DateTime?
  duration     Int?
  viewCount    BigInt?
  status       VideoStatus                  @default(DISCOVERED)
  errorMessage String?
  audioPath    String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  transcripts  Transcript[]
  extractions  Extraction[]
  evaluations  Evaluation[]
  costEvents   CostEvent[]
  batchItems   BatchItem[]
  embedding    Unsupported("vector(1536)")?

  @@unique([sourceId, externalId])
}

model Batch {
  id               String      @id @default(cuid())
  status           BatchStatus @default(DRAFT)
  requestedStages  String[]
  providerConfig   Json
  estimateSnapshot Json?
  pricingVersion   String?
  currency         String      @default("USD")
  budgetLimit      Float?
  approvedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            BatchItem[]
  costEvents       CostEvent[]
}

model BatchItem {
  id           String          @id @default(cuid())
  batchId      String
  batch        Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  videoId      String
  video        Video           @relation(fields: [videoId], references: [id], onDelete: Restrict)
  status       BatchItemStatus @default(QUEUED)
  currentStage String?
  attemptCount Int             @default(0)
  lastError    String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([batchId, videoId])
  @@index([batchId, status])
}

model Transcript {
  id         String   @id @default(cuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id])
  provider   String
  text       String
  language   String?
  durationMs Int?
  createdAt  DateTime @default(now())
}

model Extraction {
  id            String   @id @default(cuid())
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id])
  model         String
  promptVersion String
  rawJson       Json
  createdAt     DateTime @default(now())
}

model Evaluation {
  id                       String   @id @default(cuid())
  videoId                  String
  video                    Video    @relation(fields: [videoId], references: [id])
  model                    String
  promptVersion            String
  projectRelevanceScore    Float
  projectRelevance         String
  relevanceTypes           String[]
  contentOrientation       String
  targetNarratives         String[]
  recommendationValueScore Float
  recommendationValue      String
  reason                   String
  exclude                  Boolean
  excludeReason            String?
  rawJson                  Json
  createdAt                DateTime @default(now())
}

model CostEvent {
  id             String        @id @default(cuid())
  videoId        String?
  video          Video?        @relation(fields: [videoId], references: [id])
  batchId        String?
  batch          Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  stage          String
  provider       String
  kind           CostEventKind @default(ACTUAL)
  currency       String        @default("USD")
  pricingVersion String?
  idempotencyKey String?       @unique
  inputUnits     Float?
  outputUnits    Float?
  estimatedCost  Float
  createdAt      DateTime      @default(now())

  @@index([batchId, kind])
}
